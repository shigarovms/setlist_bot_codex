BOT_TOKEN=
# Separate BotFather bot for compose.sandbox.yaml; never reuse BOT_TOKEN here.
SANDBOX_BOT_TOKEN=
# Routing metadata only; no message text is logged. Off by default in production.
TELEGRAM_DIAGNOSTICS=false
DATABASE_URL=postgresql+asyncpg://setlist:setlist@localhost:5432/setlist
# Optional historical registrations not discoverable through the Bot API (JSON).
BOT_COMMAND_LEGACY_LANGUAGES=[]
BOT_COMMAND_EXTRA_SCOPES=[]
# Server deployment only; set locally, never commit a real password.
# COMPOSE_FILE=compose.yaml:compose.production.yaml
# POSTGRES_PASSWORD=<generate with openssl rand -hex 32>
